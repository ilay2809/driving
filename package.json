{
  "name": "driving-sim-il",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "סימולטור נהיגה תלת-ממדי ללימוד נהיגה ותיאוריה לרישיון B (אוטומט) בישראל — עולם לפי צפון תל אביב",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "world:fetch": "tsx tools/world/fetch-osm.ts",
    "world:fetch-tlv": "tsx tools/world/fetch-tlv.ts",
    "world:build": "tsx tools/world/build-world.ts",
    "world:all": "pnpm world:fetch && pnpm world:fetch-tlv && pnpm world:build",
    "content:theory": "tsx tools/content/import-theory.ts",
    "content:signs": "tsx tools/content/build-signs.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.6.5",
    "@types/rbush": "^4.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.3",
    "rbush": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
